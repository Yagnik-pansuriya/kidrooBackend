# === APPLICATION ===
NODE_ENV=production
PORT=5000

# === DATABASE ===
DB_URL=mongodb+srv://username:password@cluster.mongodb.net/kidroo

# === SECURITY ===
# Comma-separated list of allowed origins for CORS
# Add your Vercel frontend URL here
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# === JWT Configuration ===
# IMPORTANT: Use a strong, unique secret in production!
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-key-min-32-characters-long-change-this
JWT_EXPIRE=7d

# === CLOUDINARY (File Upload) ===
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# === OPTIONAL ===
LOG_LEVEL=warn
REQUEST_TIMEOUT=30000

# === REDIS ===
REDIS_URL=redis://default:<REDIS_PASSWORD>@<REDIS_HOST>:<REDIS_PORT>

# ─────────────────────────────────────────────────────────────────────────────
# SMS / OTP Provider
# ─────────────────────────────────────────────────────────────────────────────
# Controls which service sends OTPs (signup verification, forgot password).
#
#   "twilio"  → Twilio SMS (plain text message with OTP in body)
#   "msg91"   → MSG91 OTP API v5 (template-based, DLT-compliant, recommended for India)
#
# Both providers are fully implemented. Switch between them by changing this value.
# All other configuration (Twilio or MSG91) must also be filled in below.
# ─────────────────────────────────────────────────────────────────────────────
SMS_PROVIDER=msg91

# ─────────────────────────────────────────────────────────────────────────────
# TWILIO SMS
# Required when SMS_PROVIDER=twilio
# ─────────────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ─────────────────────────────────────────────────────────────────────────────
# MSG91 SMS + OTP
# Required when SMS_PROVIDER=msg91
# ─────────────────────────────────────────────────────────────────────────────
# Your MSG91 authentication key (from https://control.msg91.com)
MSG91_AUTH_KEY=your_msg91_auth_key

# ── OTP API (v5) ──────────────────────────────────────────────────────────────
# Used for signup & password reset OTPs.
# Create an OTP template in your MSG91 dashboard and paste the template ID here.
# If not set, falls back to plain SMS via MSG91 SMS API (below).
MSG91_OTP_TEMPLATE_ID=your_otp_template_id

# ── Plain SMS API (v2) ────────────────────────────────────────────────────────
# Used for non-OTP transactional messages.
# Also used as OTP fallback when MSG91_OTP_TEMPLATE_ID is not set.
MSG91_SENDER_ID=KIDROO
MSG91_ROUTE=4
MSG91_COUNTRY=91
# DLT registration values (required for Indian delivery compliance)
MSG91_TEMPLATE_ID=your_dlt_template_id
MSG91_ENTITY_ID=your_dlt_entity_id

# ─────────────────────────────────────────────────────────────────────────────
# MSG91 WhatsApp (Transactional Templates)
# ─────────────────────────────────────────────────────────────────────────────
# Must match the approved template names in your MSG91 dashboard.
# Create & get Meta approval for all templates before enabling.
#
# Template: kidroo_order_confirmed
#   Variables: {{1}} Customer Name, {{2}} Order ID, {{3}} Total Amount, {{4}} Payment Method
#
# Template: kidroo_order_status
#   Variables: {{1}} Customer Name, {{2}} Order ID, {{3}} New Order Status
#
# Template: kidroo_promo_blast
#   Variables: {{1}} Customer Name, {{2}} Promo Message / Offer Details
#
MSG91_WA_TEMPLATE_ORDER_CONFIRMED=kidroo_order_confirmed
MSG91_WA_TEMPLATE_ORDER_STATUS=kidroo_order_status
MSG91_WA_TEMPLATE_PROMO_BLAST=kidroo_promo_blast
# Your MSG91 WhatsApp integrated/approved number (with country code, no + sign)
# Find this in MSG91 dashboard → WhatsApp → Integrated Numbers
# Example: 919876543210  (91 = India country code + 10-digit number)
MSG91_WA_INTEGRATED_NUMBER=91XXXXXXXXXX

# ─────────────────────────────────────────────────────────────────────────────
# RAZORPAY (Online Payments)
# ─────────────────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
